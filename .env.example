# Copier ce fichier en .env avant le premier lancement : cp .env.example .env
# Identifiants d'une base LOCALE de formation : ne jamais réutiliser ces valeurs ailleurs.

# Utilisés par le conteneur PostgreSQL
POSTGRES_USER=escale
POSTGRES_PASSWORD=escale_dev
POSTGRES_DB=escale

# Utilisée par Python (notebooks et train.py) pour se connecter à la base
DATABASE_URL=postgresql+psycopg://escale:escale_dev@localhost:5432/escale
